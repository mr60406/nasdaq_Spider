from bs4 import BeautifulSoup
import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry


headers = {
    "Accept": "application/rss+xml, application/xml, text/xml, */*",
    "Accept-Language": "zh-TW,zh;q=0.9,en-US;q=0.8,en;q=0.7",
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/139.0.0.0 Safari/537.36"
    ),
}


def parser(url):

    session = requests.Session()

    retry = Retry(
        total=3,
        connect=3,
        read=3,
        backoff_factor=2,
        status_forcelist=[429, 500, 502, 503, 504],
        allowed_methods=["GET"]
    )

    adapter = HTTPAdapter(max_retries=retry)

    session.mount("https://", adapter)
    session.mount("http://", adapter)

    response = session.get(
        url,
        headers=headers,
        timeout=(10, 90)
    )

    response.raise_for_status()

    return BeautifulSoup(response.content, "xml")

url = (
    "https://www.globenewswire.com/"
    "RssFeed/orgclass/1/"
    "feedTitle/GlobeNewswire%20-%20News%20about%20Public%20Companies"
)

soup = parser(url)

news_lists = soup.find_all("item")

for news in news_lists:
    title = news.find("title")
    link = news.find("link")
    pub_date = news.find("pubDate")
    description = news.find("description")

    print("=" * 80)

    if title:
        print(f"新聞標題: {title.get_text(strip=True)}")

    if link:
        print(f"新聞網址: {link.get_text(strip=True)}")

    if pub_date:
        print(f"發布時間: {pub_date.get_text(strip=True)}")

    if description:
        print(f"新聞摘要: {description.get_text(strip=True)}")